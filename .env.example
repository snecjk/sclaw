# StoClaw Environment Variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# Development Configuration
VITE_DEV_SERVER_PORT=5173

# 本地调试 memory-center API（可选，写入 .env.development.local）
# STO_MEMORY_CENTER_BASE_URL=http://127.0.0.1:7001

# StoClaw 钉钉 Channel Hub（sto-wisdom-star，勿尾斜杠）
# 测试：STO_SCLAW_HUB_BASE_URL=https://baseinfo-chatbotapi-test.sto.cn
# 预发：STO_SCLAW_HUB_BASE_URL=https://pre-baseinfo-chatbotapi.sto.cn
# 生产：STO_SCLAW_HUB_BASE_URL=https://baseinfo-chatbotapi.sto.cn
# 或：STO_WISDOM_STAR_BASE_URL=...

# iframe 工作流编辑器 MC Web 地址（development 默认本地 MC）
# VITE_MEMORY_CENTER_WEB_ORIGIN=http://localhost:5173
# 测试环境：
# VITE_MEMORY_CENTER_WEB_ORIGIN=https://front-test.sto.cn/group/memory-center-web

# Release Configuration (CI/CD)
# Apple Developer Credentials
APPLE_ID=your@email.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Code Signing Certificate
CSC_LINK=path/to/certificate.p12
CSC_KEY_PASSWORD=certificate_password

# GitHub Token for releases
GH_TOKEN=github_personal_access_token

·# AgentLoop / ARMS 可观测性（详见 docs/agentloop-setup.md）
# 实际配置分别维护在 .env.development/.env.test/.env.staging/.env.production；
# 四个 mode 共用接入参数；命名规则：SClaw-<Agent框架名>-<环境名>。以下均为无效占位符。
# ARMS_LICENSE_KEY=your_agentloop_license_key
# ARMS_APP_NAME=SClaw-<Claude_Agent_SDK|Pi_Agent_SDK>-<dev|test|online>
# ARMS_REGION_ID=cn-shanghai
# ARMS_WORKSPACE=your_agentloop_workspace
# span 控制台输出与探针日志：
# ARMS_ENABLE_CONSOLE_EXPORTER=true
# OTEL_LOG_LEVEL=debug
# ARMS「会话消息」需要此开关，否则用户话术不会出现在对话详情里：
# OTEL_INSTRUMENTATION_GENAI_EMIT_EVENT=true
