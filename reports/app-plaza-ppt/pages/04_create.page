pageType: content
background:
  type: solid
  color: $bg
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 36, 500, 18]
    content: {style: $kicker, wrap: false, text: 02 · 核心能力 · 代码管理}
  - elementId: title
    elementType: text
    bounds: [60, 58, 900, 40]
    content: {style: $pagetitle, wrap: false, text: 如何管理代码：建仓、同步、冲突、凭证全自动}
  - elementId: rule
    elementType: shape
    bounds: [60, 110, 64, 4]
    shapeName: rect
    fill: {type: solid, color: $accent}
  - elementId: hairline
    elementType: shape
    bounds: [60, 118, 840, 1]
    shapeName: rect
    fill: {type: solid, color: $hairline}
  - elementId: flow-label
    elementType: text
    bounds: [60, 140, 840, 18]
    content:
      fontSize: 13
      bold: true
      color: $accent
      wrap: false
      text: 用户侧：只点「创建 / 保存」—— 系统侧自动完成整条代码生命周期
  - elementId: f1-box
    elementType: shape
    bounds: [60, 170, 150, 70]
    shapeName: rect
    fill: {type: solid, color: $pale}
    border: {style: solid, width: 2, color: $accent}
  - elementId: f1-text
    elementType: text
    bounds: [60, 170, 150, 70]
    content:
      align: [center, middle]
      lineHeight: 1.35
      text: |
        <p style="text-align:center"><span style="font-size:13px; color:$ink"><strong>① 创建即建仓</strong></span></p>
        <p style="text-align:center"><span style="font-size:11px; color:$muted">sto-app CLI 自动建仓</span></p>
  - elementId: a1
    elementType: line
    bounds: [210, 203, 30, 3]
    viewBox: [30, 3]
    points: "0,1.5 30,1.5"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: $accent}
  - elementId: f2-box
