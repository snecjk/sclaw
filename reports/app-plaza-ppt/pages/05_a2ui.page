pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 36, 560, 18]
    content: {style: "$kicker", wrap: false, text: "03 · 核心能力 · 应用渲染（A2UI）"}
  - elementId: title
    elementType: text
    bounds: [60, 58, 900, 40]
    content: {style: "$pagetitle", wrap: false, text: "A2UI 怎么渲染应用：描述进、界面出，安全可预览"}
  - elementId: rule
    elementType: shape
    bounds: [60, 110, 64, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: hairline
    elementType: shape
    bounds: [60, 118, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: flow-label
    elementType: text
    bounds: [60, 138, 840, 18]
    content:
      fontSize: 13
      bold: true
      color: "$accent"
      wrap: false
      text: 渲染链路（不是 AI 写代码，是 AI 写描述 → 官方渲染器出界面）
  - elementId: f1-box
    elementType: shape
    bounds: [60, 166, 140, 64]
    shapeName: rect
    fill: {type: solid, color: "$pale"}
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: f1-text
    elementType: text
    bounds: [60, 166, 140, 64]
    content:
      align: [center, middle]
      lineHeight: 1.35
      text: |
        <p style="text-align:center"><span style="font-size:13px; color:$ink"><strong>自然语言</strong></span></p>
        <p style="text-align:center"><span style="font-size:11px; color:$muted">用户描述需求</span></p>
  - elementId: a1
    elementType: line
    bounds: [200, 196, 30, 3]
    viewBox: [30, 3]
    points: "0,1.5 30,1.5"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: f2-box
    elementType: shape
    bounds: [230, 166, 150, 64]
