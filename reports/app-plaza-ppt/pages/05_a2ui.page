      align: [center, middle]
      lineHeight: 1.35
      text: |
        <p style="text-align:center"><span style="font-size:13px; color:$ink"><strong>page.json</strong></span></p>
        <p style="text-align:center"><span style="font-size:11px; color:$muted">组件树 + 数据描述</span></p>
  - elementId: a2
