pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 36, 500, 18]
    content: {style: "$kicker", wrap: false, text: "02 · 三步总览"}
  - elementId: title
    elementType: text
    bounds: [60, 58, 860, 40]
    content: {style: "$pagetitle", wrap: false, text: "用户只走三步，每步对应一组技术抓手"}
  - elementId: rule
    elementType: shape
    bounds: [60, 110, 64, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: hairline
    elementType: shape
    bounds: [60, 118, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: chain-line
    elementType: shape
    bounds: [80, 190, 800, 2]
    shapeName: rect
    fill: {type: solid, color: "$pale"}
  - elementId: s1-num
    elementType: text
    bounds: [80, 156, 60, 28]
    content: {fontSize: 20, bold: true, color: "$accent", wrap: false, text: "①"}
  - elementId: s1-head
    elementType: text
    bounds: [80, 212, 220, 26]
    content: {fontSize: 17, bold: true, color: "$ink", wrap: false, text: "创建应用"}
  - elementId: s1-user
    elementType: text
    bounds: [80, 244, 230, 20]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: "用户：填名称、点创建"}
  - elementId: s1-body
    elementType: text
    bounds: [80, 268, 230, 90]
    content: {style: "$small", text: "前端模板初始化、环境托管；Git 建仓与代码管理全自动（重点）"}
  - elementId: s2-num
    elementType: text
    bounds: [380, 156, 60, 28]
    content: {fontSize: 20, bold: true, color: "$accent", wrap: false, text: "②"}
  - elementId: s2-head
    elementType: text
    bounds: [380, 212, 240, 26]
    content: {fontSize: 17, bold: true, color: "$ink", wrap: false, text: "A2UI 生成页面"}
  - elementId: s2-user
    elementType: text
    bounds: [380, 244, 240, 20]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: "用户：自然语言描述需求"}
  - elementId: s2-body
    elementType: text
    bounds: [380, 268, 240, 90]
    content: {style: "$small", text: "A2UI 写页面描述而非代码 + 内置 antd / stoDesign，安全可控、秒级预览、改坏可回滚"}
  - elementId: s3-num
    elementType: text
    bounds: [690, 156, 60, 28]
    content: {fontSize: 20, bold: true, color: "$accent", wrap: false, text: "③"}
  - elementId: s3-head
    elementType: text
    bounds: [690, 212, 230, 26]
    content: {fontSize: 17, bold: true, color: "$ink", wrap: false, text: "低成本发布"}
  - elementId: s3-user
    elementType: text
    bounds: [690, 244, 230, 20]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: "用户：点「保存并发布」"}
  - elementId: s3-body
    elementType: text
    bounds: [690, 268, 230, 90]
    content: {style: "$small", text: "推送 Git → DevOps 构建 → 静态托管上线；无常驻服务，成本极低"}
  - elementId: takeaway-line
    elementType: shape
    bounds: [60, 400, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$hairline"}
  - elementId: takeaway
    elementType: text
    bounds: [60, 420, 840, 26]
    content:
      fontSize: 15
      bold: true
      color: "$ink"
      wrap: false
      text: "下面按这三步展开：建仓怎么管、A2UI 怎么生成前端页面、怎么低成本发布上线。"
  - elementId: footer
    elementType: text
    bounds: [60, 506, 400, 16]
    content: {style: "$small", wrap: false, text: "应用广场 · 用户应用开发 · 周会同步"}
  - elementId: pagenum
    elementType: text
    bounds: [860, 506, 40, 16]
    content: {style: "$small", wrap: false, align: [right, top], text: "02"}
