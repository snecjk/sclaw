{
  "id": "sto-browser-automation",
  "name": "StoClaw Browser Automation",
  "description": "Browser Automation Platform — ba_observe / ba_act / ba_wait / ba_validate",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "hostApiHost": {
        "type": "string",
        "default": "127.0.0.1"
      },
      "hostApiPort": {
        "type": "number",
        "default": 3210
      },
      "commandTimeoutMs": {
        "type": "number",
        "default": 120000
      }
    }
  },
  "tools": [
    "ba_create_session",
    "ba_observe",
    "ba_act",
    "ba_wait",
    "ba_validate",
    "ba_start_run"
  ]
}
