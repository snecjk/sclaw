{
  "id": "sto-scheduled-task-tool",
  "name": "申通定时任务创建工具",
  "description": "提供从自然语言创建定时任务的工具，支持意图识别和参数提取",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "hostApiHost": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "StoClaw HostApi 地址（创建任务打 /api/scheduled-tasks）"
      },
      "hostApiPort": {
        "type": "number",
        "default": 3210,
        "description": "StoClaw HostApi 端口"
      },
      "timeoutMs": {
        "type": "number",
        "default": 60000,
        "description": "HostApi 请求超时（毫秒）"
      }
    }
  },
  "uiHints": {
    "toolSelection": {
      "label": "工具选择",
      "help": "选择要启用的工具"
    }
  }
}
