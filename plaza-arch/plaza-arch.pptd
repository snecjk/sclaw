version: v2
title: SClaw 应用广场互通架构
size: [960, 540]
theme:
  colors:
    primary: "#1A1A2E"
    accent: "#D97706"
    text: "#374151"
    muted: "#6B7280"
    light: "#F3F4F6"
    border: "#E5E7EB"
    white: "#FFFFFF"
  textStyles:
    title:
      fontSize: 28
      color: "$primary"
      bold: true
      lineHeight: 1.3
    subtitle:
      fontSize: 14
      color: "$muted"
      lineHeight: 1.4
    body:
      fontSize: 13
      color: "$text"
      lineHeight: 1.5
    label:
      fontSize: 11
      color: "$muted"
      lineHeight: 1.3
    caption:
      fontSize: 12
      color: "$muted"
      lineHeight: 1.4
      italic: true
  tableStyles:
    default:
      cellStyle:
        fontSize: 12
        color: "$text"
        lineHeight: 1.4
        border: null
        align: [left, middle]
      firstRowStyle:
        fontSize: 12
        bold: true
        color: "$primary"
        border: [null, null, {style: solid, width: 2, color: "$accent"}, null]
        align: [left, middle]
      bodyStyles:
        - border: [null, null, {style: solid, width: 1, color: "$border"}, null]
      rowOverColumn: true
pages:
  - pages/1_architecture.page
  - pages/2_mechanism.page
