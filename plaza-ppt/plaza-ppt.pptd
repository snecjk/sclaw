version: v2
title: SClaw JSBridge 平台设计
theme:
  colors:
    primary: "#1A1A2E"
    accent: "#D97706"
    text: "#374151"
    muted: "#6B7280"
    light: "#F3F4F6"
    border: "#E5E7EB"
    white: "#FFFFFF"
    green: "#059669"
    red: "#DC2626"
  textStyles:
    title:
      fontSize: 26
      color: $primary
      bold: true
      lineHeight: 1.3
    subtitle:
      fontSize: 13
      color: $muted
      lineHeight: 1.4
  tableStyles:
    default:
      cellStyle:
        fontSize: 11
        color: $text
        lineHeight: 1.4
        border: null
        align: [left, middle]
      firstRowStyle:
        fontSize: 11
        bold: true
        color: $primary
        border: [null, null, {style: solid, width: 2, color: $accent}, null]
        align: [left, middle]
      bodyStyles:
        - border: [null, null, {style: solid, width: 1, color: $border}, null]
      rowOverColumn: true
size: [960, 540]
pages:
  - pages/1_arch.page
  - pages/2_value.page
