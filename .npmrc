package-import-method=copy
shamefully-hoist=true
strict-peer-dependencies=false

# The internal registry (snpm-registry.sto.cn, from user-level ~/.npmrc) is an
# incomplete mirror: tarballs for several packages in the current lockfile 404
# (e.g. @earendil-works/pi-ai@0.84.4, @aws-sdk/client-bedrock-runtime@3.1048.0).
# Pin this project to the public npmmirror registry so installs are reproducible.
# Scope-specific overrides below (npmmirror) are then redundant but kept explicit.
registry=https://registry.npmmirror.com/

# Electron binary mirror (used by electron-builder for cross-platform downloads)
# Default GitHub releases are slow/unreachable in China; NPMMIRROR provides reliable access.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# @loongsuite (ARMS/AgentLoop CMS probe) is not mirrored by the internal registry:
# metadata redirects to npmmirror but the .tgz download 404s. Route this scope to npmmirror.
@loongsuite:registry=https://registry.npmmirror.com/

# @earendil-works (Pi coding agent) has the same problem as @loongsuite:
# the internal registry (snpm-registry.sto.cn) 404s on @earendil-works/pi-* tarballs.
# Route this scope to npmmirror (public npmjs mirror, verified to host pi-ai@0.84.4).
@earendil-works:registry=https://registry.npmmirror.com/

# @aws-sdk tarballs (e.g. client-bedrock-runtime@3.1048.0) are also missing from the
# internal registry. Route the whole AWS SDK scope to npmmirror.
@aws-sdk:registry=https://registry.npmmirror.com/
