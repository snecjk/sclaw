{
  "version": 1,
  "rule": "社区选装包必须声明 ai 字段；安装流水线 = 依赖安装 + 写入 openspec/skills + 刷新 AGENTS。禁止只装 npm 不装 AI 用法。自定义包名无清单时仅装依赖并提示缺少 AI 资产。",
  "packages": [
    {
      "id": "fe-axios",
      "kind": "frontend",
      "name": "Axios",
      "packageName": "axios",
      "npmPackages": ["axios"],
      "description": "HTTP 请求库；对接公司接口时优先配合 contracts/action-registry。",
      "ai": {
        "skillId": "pkg-axios",
        "summary": "通过 actionId 调接口，禁止在 page JSON 写死 URL。"
      }
    },
    {
      "id": "fe-dayjs",
      "kind": "frontend",
      "name": "Day.js",
      "packageName": "dayjs",
      "npmPackages": ["dayjs"],
      "description": "轻量日期时间处理。",
      "ai": {
        "skillId": "pkg-dayjs",
        "summary": "日期格式化用 dayjs；页面展示字段仍走 A2UI data model。"
      }
    },
    {
      "id": "fe-clsx",
      "kind": "frontend",
      "name": "clsx",
      "packageName": "clsx",
      "npmPackages": ["clsx"],
      "description": "条件拼接 className（Catalog/宿主样式用）。",
      "ai": {
        "skillId": "pkg-clsx",
        "summary": "仅在 Catalog/宿主 React 中使用；不要为了样式去改业务 JSX 主路径。"
      }
    },
    {
      "id": "fe-recharts",
      "kind": "frontend",
      "name": "Recharts",
      "packageName": "recharts",
      "npmPackages": ["recharts"],
      "description": "React 图表；需封装进 Catalog 后才能进 page JSON。",
      "ai": {
        "skillId": "pkg-recharts",
        "summary": "禁止在 page JSON 直接引用 Recharts；先做 Catalog 组件再引用。"
      }
    },
    {
      "id": "fe-antd",
      "kind": "frontend",
      "name": "Ant Design",
      "packageName": "antd",
      "npmPackages": ["antd"],
      "description": "企业级 UI 库。安装后仅依赖就绪；页面仍须经 A2UI Catalog 白名单使用。",
      "ai": {
        "skillId": "pkg-antd",
        "summary": "查询/列表页优先 AntdFilterBar+AntdTable+AntdPagination（catalogId: antd）。"
      }
    },
    {
      "id": "be-fastapi",
      "kind": "backend",
      "name": "FastAPI",
      "packageName": "fastapi",
      "description": "Python Web API 框架。",
      "ai": {
        "skillId": "pkg-fastapi",
        "summary": "后端接口变更后同步 docs/api 与 action-registry。"
      }
    },
    {
      "id": "be-uvicorn",
      "kind": "backend",
      "name": "Uvicorn",
      "packageName": "uvicorn",
      "description": "ASGI 服务器，配合 FastAPI。",
      "ai": {
        "skillId": "pkg-uvicorn",
        "summary": "本地启动用 uvicorn；不要把启动命令写进前端 page。"
      }
    },
    {
      "id": "be-requests",
      "kind": "backend",
      "name": "Requests",
      "packageName": "requests",
      "description": "Python HTTP 客户端。",
      "ai": {
        "skillId": "pkg-requests",
        "summary": "服务端出站请求用 requests；契约写入 docs/api。"
      }
    },
    {
      "id": "be-httpx",
      "kind": "backend",
      "name": "HTTPX",
      "packageName": "httpx",
      "description": "支持异步的 Python HTTP 客户端。",
      "ai": {
        "skillId": "pkg-httpx",
        "summary": "异步出站优先 httpx；保持与 docs/api 一致。"
      }
    },
    {
      "id": "be-pydantic",
      "kind": "backend",
      "name": "Pydantic",
      "packageName": "pydantic",
      "description": "数据校验与模型定义。",
      "ai": {
        "skillId": "pkg-pydantic",
        "summary": "请求/响应模型与 docs/api、action 契约字段对齐。"
      }
    }
  ]
}
