# 本地联调 SSO 环境：daily=测试 pre=预发 prod=生产
# 须与 SSO 登录跳转的用户中心一致，否则 code 换票会失败
# 测试域 baseinfo-usercenterapi-hq-test 若不可达，请改为 prod
VITE_SSO_ENV=prod

# 可选：显式覆盖（优先级高于 VITE_SSO_ENV）
# VITE_SSO_BASE_URL=https://baseinfo-usercenterserviceapi-hq-test.sto.cn
# VITE_SSO_API_BASE_URL=https://baseinfo-usercenterapi-test.sto.cn
# SSO_API_PROXY_TARGET=https://baseinfo-usercenterapi-test.sto.cn

# 子系统编码（在用户中心申请回调地址后配置）
VITE_SSO_SYSTEM_CODE=STO_CLAW_APP
