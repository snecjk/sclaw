registry=http://snpm-registry.sto.cn
@sto:registry=http://snpm-registry.sto.cn
@alifd:registry=http://snpm-registry.sto.cn

# snpm defaults to an isolated dependency tree. Vite must resolve Ant Design's
# direct imports from the app root, so expose the complete dependency graph.
package-import-method=copy
shamefully-hoist=true
strict-peer-dependencies=false
