{
  "name": "daily-network-report",
  "cliCommand": "your-cli-tool get-network-stats --date today --format json",
  "workingDir": "/path/to/your/cli/tool",
  "template": "assets/network-report-template.html",
  "outputDir": ".claw-output",
  "outputFilename": "network-report-{date}.html",
  "parseScript": "scripts/parse_network_data.py",
  "env": {
    "API_KEY": "${NETWORK_API_KEY}",
    "CLI_TOKEN": "${CLI_TOKEN}"
  },
  "schedule": {
    "enabled": true,
    "cron": "0 9 * * *",
    "timezone": "Asia/Shanghai"
  },
  "dataMapping": {
    "report_title": "网络贡献达成",
    "period": "0417",
    "slogan": "我为人人 人人为我",
    "underperforming_regions": "江苏、湖北、江西、内蒙古、贵州、广西",
    "notes": "进港利润=进港派费利润 + 周期性利润 + 网点补贴支出",
    "data_source": "CLI Network Stats"
  }
}
