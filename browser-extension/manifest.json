{
  "manifest_version": 3,
  "name": "SClaw Web Bridge",
  "description": "Drive the current Chrome tab from SClaw over a local loopback Host API. Page ops use chrome.debugger, not content scripts.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "debugger",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SClaw Web Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
