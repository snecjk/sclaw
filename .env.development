VITE_APP_ENV=development

# —— memory-center：走测试（跟日常登录 SSO 环境走，勿配本地）——
# 不设 STO_MEMORY_CENTER_BASE_URL 时，日常登录 → https://baseinfo-aimemory-test.sto.cn
# 仅当要联调本地 MC 时再打开下一行（会与本地智多星抢 7001，不建议同时开）：
# STO_MEMORY_CENTER_BASE_URL=http://127.0.0.1:7001
# STO_MEMORY_CENTER_BASE_URL=https://baseinfo-aimemory-test.sto.cn
# iframe 编辑页接本地 memory-center-web（需先在 memory-center-web 目录 pnpm dev）
# VITE_MEMORY_CENTER_WEB_ORIGIN=http://localhost:5173
# 切回测试环境 MC Web 时用：
# VITE_MEMORY_CENTER_WEB_ORIGIN=https://front-test.sto.cn/group/memory-center-web
# STO_MEMORY_CENTER_BASE_URL=http://127.0.0.1:7001

# iframe 编辑页（默认跟发布包/测试前端；本地 MC Web 才改）
# VITE_MEMORY_CENTER_WEB_ORIGIN=https://front-test.sto.cn/group/memory-center-web
# VITE_MEMORY_CENTER_WEB_ORIGIN=http://localhost:5173

# —— 智多星 Channel Hub（与 .env.test 一致，勿尾斜杠）——
 STO_SCLAW_HUB_BASE_URL=https://baseinfo-chatbotapi-test.sto.cn
# 联调本地 Hub（sto-wisdom-star）时再改：
# STO_SCLAW_HUB_BASE_URL=http://127.0.0.1:7001
