{
  "name": "@sto/claw-bridge-sdk",
  "version": "1.1.1",
  "description": "SClaw JSBridge SDK for *.sto.cn H5 pages embedded in SClaw webview",
  "license": "UNLICENSED",
  "author": "caoyu@sto.cn",
  "maintainers": [
    "1119856"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "jsbridge-api.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "http://snpm-registry.sto.cn"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
